; Engine configuration file.
config_version=5

[application]

config/version="0.2.0"

config/name="City Invaders"
config/description="Walk real cities (OpenStreetMap + Mapillary facades) together online."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

occlusion_culling/use_occlusion_culling=true

anti_aliasing/quality/msaa_3d=2

[autoload]

DevAgent="*res://scripts/dev_agent.gd"
Settings="*res://scripts/settings.gd"
Sfx="*res://scripts/sfx.gd"
Tune="*res://scripts/tune.gd"
Online="*res://scripts/online.gd"

[physics]

common/physics_interpolation=true
3d/physics_engine="Jolt Physics"
