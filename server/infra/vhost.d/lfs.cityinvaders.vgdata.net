# nginx-proxy per-host settings for the City Invaders LFS (Forgejo).
# Copy to /srv/docker/nginx-proxy/vhost.d/lfs.cityinvaders.vgdata.net
# LFS uploads are whole files (a city glb is over 100 MB): no body limit, and no
# buffering of the upload to nginx's disk first.
client_max_body_size 0;
proxy_request_buffering off;
proxy_read_timeout 600s;
proxy_send_timeout 600s;
