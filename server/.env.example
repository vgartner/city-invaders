# City Invaders API - environment. Copy to .env (chmod 600). Never commit .env.
# On VGData it lives at /srv/city-invaders/.env and is referenced by infra/city-invaders.yml.

# --- secrets / keys ---------------------------------------------------------------------
# Public key shipped inside the game build; sent as the X-Game-Key header. Not a secret,
# it only keeps random scanners out. Change it per release line if it gets abused.
GAME_CLIENT_KEY=change-me-game-key
# Admin + MCP bearer token (>= 24 chars). Generate: openssl rand -hex 32
ADMIN_TOKEN=
# Bah's language model: any OpenAI-compatible chat API (as in Synaptia and Horario IA).
# Default OpenRouter; for OpenAI direct use https://api.openai.com/v1 and a plain model name.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Empty = /api/bah/chat answers 503 bah_unavailable.
LLM_API_KEY=

# --- Bah ------------------------------------------------------------------------------------
# OpenRouter slug provider/model, e.g. openai/gpt-4o-mini, anthropic/claude-haiku-4.5, google/gemini-2.5-flash
BAH_MODEL=openai/gpt-4o-mini
BAH_MAX_OUTPUT_TOKENS=400
# Exchanges (user + assistant pairs) kept as history.
BAH_HISTORY_TURNS=12
BAH_MESSAGE_MAX_CHARS=500
# Daily budget (UTC day, all players): input + output + cache writes + 1/10 of cache reads. 0 = unlimited.
BAH_DAILY_TOKEN_BUDGET=2000000
# Knowledge files (defaults: the copies baked into the image under /app/knowledge).
#BAH_GAMEPLAY_PATH=/app/knowledge/GAMEPLAY.md
#BAH_FAQ_PATH=/app/knowledge/bah_faq.json

# --- rate limits (0 disables a rule) -------------------------------------------------------
CHAT_LIMIT_PER_SESSION=20
CHAT_LIMIT_PER_IP=20
CHAT_LIMIT_WINDOW_SEC=600
FEEDBACK_LIMIT_PER_IP=10
FEEDBACK_LIMIT_WINDOW_SEC=3600
MOD_UPLOAD_LIMIT_PER_IP=5
MOD_UPLOAD_LIMIT_WINDOW_SEC=3600

# --- sizes ----------------------------------------------------------------------------------
FEEDBACK_SCREENSHOT_MAX_BYTES=3145728
MOD_MAX_BYTES=26214400

# --- runtime --------------------------------------------------------------------------------
PORT=8080
#HOST=0.0.0.0
# Reverse-proxy hops to trust for X-Forwarded-For (nginx-proxy in front = 1; 0 locally without a proxy is also fine).
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
# Local runs default to ./data; the image sets DATA_DIR=/data (the mounted volume).
#DATA_DIR=./data
