{
  "name": "city-invaders-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for City Invaders: Bah (in-game AI assistant), feedback reports, mod sharing and an MCP admin endpoint.",
  "license": "SEE LICENSE IN ../LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch-path=dist --env-file-if-exists=.env dist/src/index.js",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
